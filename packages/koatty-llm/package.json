{
  "name": "koatty_llm",
  "version": "1.0.0",
  "description": "LLM calling abstraction for Koatty: provider adapters, model routing, reliability, budgets, structured output and tool-call loops.",
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:dts && pnpm run build:cp",
    "build:js": "tsup",
    "build:dts": "bash ../../scripts/build-dts.sh",
    "build:cp": "node ../../scripts/postBuild.js",
    "clean": "rimraf dist temp docs/api",
    "lint": "eslint --ext .ts,.js ./src",
    "test": "pnpm run lint && jest --passWithNoTests"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koatty/koatty_llm.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": {
    "name": "richenlin",
    "email": "richenlin@gmail.com"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/koatty/koatty_llm/issues"
  },
  "homepage": "https://github.com/koatty/koatty_llm",
  "maintainers": [
    {
      "name": "richenlin",
      "email": "richenlin@gmail.com"
    }
  ],
  "devDependencies": {
    "@microsoft/api-documenter": "^7.26.x",
    "@microsoft/api-extractor": "^7.52.x",
    "@types/jest": "^29.5.x",
    "@types/node": "^22.x.x",
    "@typescript-eslint/eslint-plugin": "^8.x.x",
    "@typescript-eslint/parser": "^8.x.x",
    "class-validator": "^0.14.3",
    "eslint": "^8.x.x",
    "eslint-plugin-jest": "^28.x.x",
    "jest": "^29.x.x",
    "jest-html-reporters": "^3.x.x",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.x.x",
    "tslib": "^2.x.x"
  },
  "dependencies": {
    "koatty_validation": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "koatty_cacheable": "^1.0.0",
    "koatty_store": "^1.0.0",
    "koatty_validation": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "koatty_cacheable": {
      "optional": true
    },
    "koatty_store": {
      "optional": true
    }
  },
  "types": "./dist/index.d.ts"
}
