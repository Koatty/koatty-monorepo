{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "outDir": "./temp",
    "rootDir": "./src",
    "typeRoots": [
      "node_modules/@types"
    ],
    "resolvePackageJsonExports": true,
    "moduleResolution": "node16",
    "module": "Node16"
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "src/**/*"
  ]
}
