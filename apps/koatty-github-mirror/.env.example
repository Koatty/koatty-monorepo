# Set your hostname for automatic HTTPS, or http://:80 for an HTTP-only IP test.
SITE_ADDRESS=mirror.example.com
# Optional dedicated HTTPS origin for generated Git links; empty uses the web origin.
MIRROR_GIT_BASE_URL=
MIRROR_MAX_CONCURRENT=32
MIRROR_MAX_PER_CLIENT=4
MIRROR_REQUESTS_PER_MINUTE=120
MIRROR_TRANSFER_TIMEOUT_MS=1800000

# Read negotiation limit / streamed push pack limit (bytes).
MIRROR_MAX_GIT_BODY_BYTES=8388608
MIRROR_MAX_GIT_PUSH_BODY_BYTES=536870912
